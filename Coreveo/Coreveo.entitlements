<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Disable App Sandbox for system monitoring capabilities -->
	<key>com.apple.security.app-sandbox</key>
	<false/>
	
	<!-- Network access for network monitoring -->
	<key>com.apple.security.network.client</key>
	<true/>
	<key>com.apple.security.network.server</key>
	<true/>
	
	<!-- Allow JIT for potential performance optimization -->
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
	
	<!-- Allow unsigned executable memory (some monitoring tools need this) -->
	<key>com.apple.security.cs.allow-unsigned-executable-memory</key>
	<true/>
	
	<!-- Allow DYLD environment variables -->
	<key>com.apple.security.cs.allow-dyld-environment-variables</key>
	<true/>
	
	<!-- Disable library validation to allow loading system frameworks -->
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
</dict>
</plist>
